# Editors / tooling
.idea
.vscode
.DS_Store

# OMC orchestration state
.omc/

# Superpowers brainstorming sessions (mockups, server state)
.superpowers/

# Obsidian (if the vault is opened in Obsidian)
.obsidian/
.trash/

# --- Personal vault data ---
# The repo tracks the framework (CLAUDE.md, README.md, slash commands, etc.).
# A user's actual goals, sources, and journal entries are personal and never
# get checked in. Remove these lines if you fork this repo to keep your own
# vault under version control in a private remote.
goals/
_shared/
_meta/
LOG.md
INDEX.md
lint-*.md

# Sisyphus runtime
.sisyphus/

# Next.js
web/node_modules
web/.next
web/out

# Un-ignore test fixtures (the vault ignore patterns above are global,
# but test/fixtures/vault/ must be tracked).
!web/test/
!web/test/fixtures/
!web/test/fixtures/vault/
!web/test/fixtures/vault/goals/
!web/test/fixtures/vault/goals/**
!web/test/fixtures/vault/_shared/
!web/test/fixtures/vault/_shared/**
!web/test/fixtures/vault/LOG.md
!web/test/fixtures/vault/INDEX.md
